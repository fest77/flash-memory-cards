# Android build outputs
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/index.html
android/app/src/main/assets/*.html

# APK / signing material
*.apk
# ...except the ready-to-install APK shipped at the repo root
!MDFlashCards-*.apk
*.aab
*.jks
*.keystore
# 固定调试签名（debug 密钥按 Android 惯例不是机密），随仓库提交以保证 CI 构建签名一致、可覆盖安装
!android/debug.keystore

# Python
__pycache__/
*.pyc
.venv/

# 本地生成的内置题库数据（由 md闪卡资料 通过 scripts/build_interview_*.py 生成，不入库）
src/bundled-decks.js
src/bundled-images.js
src/bundled-images-lite.js

